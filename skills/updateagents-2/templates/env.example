# 📋 Environment Variables Template
#
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Every variable here must have a non-sensitive placeholder — no real keys.

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# ── Database (example placeholders) ───────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# ── Auth (example placeholders) ───────────────────────────────
AUTH_SECRET=replace-with-a-long-random-string
AUTH_PROVIDER_API_KEY=sk-REPLACE_WITH_REAL_KEY

# ── Add project-specific variables below this line ───────────
